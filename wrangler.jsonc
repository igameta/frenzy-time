{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "frenzy-time",
    "compatibility_date": "2026-10-12",
    "main": "worker/index.js",
    "build": {
        "command": "npm run build:worker"
    },
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
    },
    "vars": {
        "CSV_CACHE_TTL_SECONDS": "120"
    }
}
