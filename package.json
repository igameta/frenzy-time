{
  "name": "frenzy-time",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:worker": "node scripts/build.mjs --cloudflare",
    "preview": "node scripts/serve.mjs dist",
    "dev:worker": "wrangler dev",
    "check:worker": "wrangler deploy --dry-run",
    "test": "node --test"
  },
  "devDependencies": {
    "vite": "^8.3.4",
    "wrangler": "^4.151.3"
  }
}
